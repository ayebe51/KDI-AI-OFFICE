# ==========================================================
# .env.local.example
# KDI AI OFFICE — LOCAL DOCKER DEPLOYMENT ENVIRONMENT TEMPLATE
# (Non-sensitive default values for local workstation deployment)
# ==========================================================

# Deployment Target Environment
NODE_ENV=production
APP_ENV=development
PORT=3000
HOST=0.0.0.0

# Security & Tokens (Synthetic local defaults)
JWT_SECRET=kdi_jwt_secret_local_p30_10_min32chars
JWT_EXPIRES_IN=86400

# PostgreSQL 16 (Local Docker Isolated Container)
POSTGRES_DB=kdi_ai_office_local
POSTGRES_USER=kdi_local_admin
POSTGRES_PASSWORD=kdi_local_secure_2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_URL=postgresql://kdi_local_admin:kdi_local_secure_2026@postgres:5432/kdi_ai_office_local

# Redis 7 (Local Docker Isolated Container)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=kdi_redis_local_2026
REDIS_URL=redis://:kdi_redis_local_2026@redis:6379/0

# Neo4j 5 (Local Docker Isolated Container)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=kdi_neo4j_local_2026

# Local Host Bindings (Loopback only)
LOCAL_POSTGRES_HOST_PORT=5433
LOCAL_REDIS_HOST_PORT=6379
LOCAL_NEO4J_HTTP_PORT=7474
LOCAL_NEO4J_BOLT_PORT=7687
LOCAL_API_HOST_PORT=3000
LOCAL_WEB_HOST_PORT=5173
