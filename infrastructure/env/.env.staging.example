# KDI AI OFFICE - Staging Environment Configuration
APP_ENV=staging
APP_NAME=KDI_AI_OFFICE_STAGING
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

API_URL=https://staging-api.kdi.internal
WS_URL=wss://staging-api.kdi.internal
CORS_ORIGINS=https://staging.kdi.internal

JWT_SECRET=staging_super_secret_jwt_sign_key_minimum_32_characters_long
JWT_EXPIRES_IN=43200

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kdi_ai_office_staging
POSTGRES_USER=kdi_staging_admin
POSTGRES_PASSWORD=kdi_staging_secure_password_replace
POSTGRES_URL=postgresql://kdi_staging_admin:kdi_staging_secure_password_replace@postgres:5432/kdi_ai_office_staging

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=kdi_staging_redis_secure_password
REDIS_URL=redis://:kdi_staging_redis_secure_password@redis:6379/0

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=kdi_staging_neo4j_secure_password

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_NUM_THREADS=8
OLLAMA_NUM_GPU=0

GEMINI_API_KEY=staging_placeholder_gemini
GROQ_API_KEY=staging_placeholder_groq
OPENROUTER_API_KEY=staging_placeholder_openrouter

WORKER_MAX_CONCURRENCY=3
HOST_CPU_LIMIT_PERCENT=75
HOST_RAM_LIMIT_PERCENT=80
