# KDI AI OFFICE - Production Environment Configuration Template
# COPY THIS FILE TO .env.production ON THE OFFICE COMPUTER AND FILL REAL SECRETS.
# NEVER COMMIT REAL PRODUCTION SECRETS INTO VERSION CONTROL!

APP_ENV=production
APP_NAME=KDI_AI_OFFICE_PROD
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# Public URL accessed by Hostinger frontend via secure reverse tunnel
API_URL=https://office.yourdomain.com/api
WS_URL=wss://office.yourdomain.com/ws
CORS_ORIGINS=https://office.yourdomain.com,https://yourdomain.com

# Cryptographic Master JWT Secret (Generate via: openssl rand -base64 48)
JWT_SECRET=REPLACE_WITH_STRONG_PRODUCTION_RANDOM_SECRET_KEY_MIN_48_CHARS
JWT_EXPIRES_IN=28800

# PostgreSQL Production Container (Bound to internal Docker network)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kdi_ai_office_prod
POSTGRES_USER=kdi_prod_admin
POSTGRES_PASSWORD=GENERATE_STRONG_POSTGRES_PASSWORD_DO_NOT_REUSE
POSTGRES_URL=postgresql://kdi_prod_admin:GENERATE_STRONG_POSTGRES_PASSWORD_DO_NOT_REUSE@postgres:5432/kdi_ai_office_prod

# Redis Production Container (Internal loopback password protected)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=GENERATE_STRONG_REDIS_PASSWORD_DO_NOT_REUSE
REDIS_URL=redis://:GENERATE_STRONG_REDIS_PASSWORD_DO_NOT_REUSE@redis:6379/0

# Neo4j Production Container (Internal Bolt interface)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=GENERATE_STRONG_NEO4J_PASSWORD_DO_NOT_REUSE

# Sovereign Ollama Daemon on Office Computer
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_THREADS=6
OLLAMA_NUM_GPU=0

# Upstream Production Cloud LLM API Keys
GEMINI_API_KEY=YOUR_PRODUCTION_GOOGLE_GEMINI_API_KEY
GROQ_API_KEY=YOUR_PRODUCTION_GROQ_API_KEY
OPENROUTER_API_KEY=YOUR_PRODUCTION_OPENROUTER_API_KEY

# Worker & Resource Governance Constraints
WORKER_MAX_CONCURRENCY=4
HOST_CPU_LIMIT_PERCENT=75
HOST_RAM_LIMIT_PERCENT=80
