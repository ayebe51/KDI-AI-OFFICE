# ==========================================
# Dockerfile.web - Build Stage for React + Three.js Frontend
# Target Hosting: Hostinger Web Hosting / Static Nginx CDN
# ==========================================

FROM node:22-alpine AS builder
WORKDIR /app
RUN apk add --no-cache libc6-compat

# Copy workspace manifests
COPY package*.json ./
COPY packages/ ./packages/
COPY apps/web/package*.json ./apps/web/
RUN npm ci

# Copy source and build static artifacts
COPY . .
RUN npm run build --workspace=packages/types
RUN npm run build --workspace=packages/config
RUN npm run build --workspace=packages/shared
RUN npm run build --workspace=apps/web

# Production Web Server (for standalone container or static asset distribution)
FROM nginx:alpine AS runner
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
COPY infrastructure/docker/nginx-web.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
