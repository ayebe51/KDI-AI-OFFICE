# KDI AI OFFICE - Canonical Environment Configuration Template
# COPY THIS FILE TO .env.development OR .env.production AS APPROPRIATE.
# NEVER COMMIT ACTUAL SECRETS TO VERSION CONTROL!

# ==========================================
# 1. APPLICATION ENVIRONMENT
# ==========================================
APP_ENV=development
APP_NAME=KDI_AI_OFFICE
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Base URLs for API and WebSocket
API_URL=http://localhost:3000
WS_URL=ws://localhost:3000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==========================================
# 2. SECURITY & AUTHENTICATION
# ==========================================
# Secret used for JWT token signing (Min 32 characters)
JWT_SECRET=change_me_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=86400

# ==========================================
# 3. POSTGRESQL (OPERATIONAL SOURCE OF TRUTH)
# ==========================================
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=kdi_ai_office_dev
POSTGRES_USER=kdi_admin
POSTGRES_PASSWORD=kdi_dev_password_only
POSTGRES_URL=postgresql://kdi_admin:kdi_dev_password_only@127.0.0.1:5432/kdi_ai_office_dev

# ==========================================
# 4. REDIS (QUEUES & EPHEMERAL STATE)
# ==========================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=kdi_redis_dev_secret
REDIS_URL=redis://:kdi_redis_dev_secret@127.0.0.1:6379/0

# ==========================================
# 5. NEO4J (TOPOLOGICAL GRAPH MEMORY)
# ==========================================
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=kdi_neo4j_dev_password

# ==========================================
# 6. LOCAL INFERENCE & OLLAMA (SOVEREIGN FALLBACK)
# ==========================================
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_THREADS=6
OLLAMA_NUM_GPU=0

# ==========================================
# 7. CLOUD LLM PROVIDERS (OPTIONAL / PLACEHOLDERS)
# ==========================================
GEMINI_API_KEY=placeholder_gemini_api_key
GROQ_API_KEY=placeholder_groq_api_key
OPENROUTER_API_KEY=placeholder_openrouter_api_key

# ==========================================
# 8. RESOURCE AWARENESS & WORKERS
# ==========================================
WORKER_MAX_CONCURRENCY=2
HOST_CPU_LIMIT_PERCENT=75
HOST_RAM_LIMIT_PERCENT=80
